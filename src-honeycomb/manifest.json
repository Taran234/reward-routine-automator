{
  "manifest_version": 3,
  "name": "Reward Routine Automator — Honeycomb",
  "version": "7.0.0",
  "description": "Froyo's routine, tuned for unattended daily runs: catch-up pass, a status page for Claude to read, and a pinned extension id.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.bing.com/*",
    "https://uselessfacts.jsph.pl/*",
    "https://trends.google.com/*",
    "https://en.wikipedia.org/*",
    "https://picsum.photos/*",
    "https://*.picsum.photos/*",
    "https://*.thecatapi.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Reward Routine Automator — Honeycomb",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["status.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
